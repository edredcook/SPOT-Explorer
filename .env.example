# Place these values in the hosting service's environment settings.
# Never commit a real key, private invitation, password or session secret.
SPOT_SUPABASE_URL=https://your-project-ref.supabase.co
SPOT_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SPOT_SUPABASE_SECRET_KEY=your-server-only-secret-key
SPOT_ADMIN_EMAIL=owner@example.org
SPOT_SESSION_SECRET=generate-a-long-random-secret-in-your-hosting-service
SPOT_PUBLIC_ORIGIN=https://your-spot-explorer-host
# Local development only; never enable on a public deployment.
# SPOT_AUTH_LOCAL_PREVIEW=1

# The existing shared provider must keep public signup and anonymous users off.
# SPOT writes only app_metadata.spot_explorer. Do not copy COP31 private keys
# into source or alter its app_metadata.cop31_mfa permissions.
# Owner first sign-in requires a confirmed Supabase email/password identity.
# One web worker is required while account sessions live in process memory.
